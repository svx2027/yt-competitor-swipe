# Default .gitignore for new projects
# Copy this into a new project as `.gitignore`

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Secrets
.env
.env.local
.env.*.local
*.pem
*.key
client_secret.json
token.json

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.python-version
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
.nuxt/
out/

# Logs and temp
*.log
*.tmp
tmp/
temp/

# OS / system
Thumbs.db
desktop.ini
