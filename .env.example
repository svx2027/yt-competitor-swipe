# yt-competitor-swipe (Python engine) environment variables.
# Copy to .env (gitignored) and fill in real values. Never commit .env.
# config.yaml already documents that all secrets live here, never in tracked config.

# YouTube Data API v3 key (console.cloud.google.com -> APIs & Services -> Credentials).
# Required by src/youtube_pull.py's YouTubeClient to pull channel/video data.
YT_API_KEY=change-me

# Gemini API key (aistudio.google.com/apikey). Optional: only used by src/score.py's
# Gemini-backed title clustering. Unset is fine -- clustering falls back to the
# deterministic local method (see config.yaml: gemini.fallback_to_local_clustering).
GEMINI_API_KEY=change-me

# Override the fast Gemini model used for title/topic clustering (src/score.py).
# Optional; defaults to config.yaml's gemini.fast_default when unset.
GEMINI_MODEL_FAST=change-me

# Which vertical's config/data to load (src/common.py's vertical() resolver). Optional;
# defaults to "main" (the demo vertical shipped at the repo root). Set to a folder name
# under verticals/<name>/ to point at a different niche.
VERTICAL=change-me

# Note: this is the Python engine's root-level .env. The reports dashboard
# (dashboard/) is a separate Next.js app with its own dashboard/.env.example.
