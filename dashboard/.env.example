# Auth.js session encryption secret (generate: openssl rand -base64 32)
AUTH_SECRET=change-me

# Google OAuth client (console.cloud.google.com -> APIs & Services -> Credentials)
AUTH_GOOGLE_ID=change-me.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=change-me

# Comma-separated Google account emails allowed to sign in
ALLOWED_EMAILS=you@example.com

# Secret for signing expiring share links (rotate to kill all outstanding links)
SHARE_SECRET=change-me

# Fine-grained GitHub PAT (contents R/W on svx2027/yt-competitor-swipe). Powers the
# Refresh button and the scheduled reconcile, pulls branch-stranded reports onto main.
GITHUB_TOKEN=change-me

# Repo the Refresh/reconcile GitHub calls target. Defaults to svx2027/yt-competitor-swipe
# in code if unset; only set this to override.
GITHUB_REPO=change-me

# Shared secret for the Vercel Cron reconcile endpoint (generate: openssl rand -hex 32).
# Vercel injects it as `Authorization: Bearer <CRON_SECRET>` on cron calls; the
# /api/reconcile route rejects anything else. Without it the endpoint fails closed (503).
CRON_SECRET=change-me

# Per-vertical client login. Generate each hash with:
#   node scripts/hash-password.mjs 'chosen-password'
# Unset verticals simply have no client login slot (the credentials form rejects any
# username that doesn't match a configured vertical or the legacy guest account below).
CLIENT_FITNESS_USERNAME=change-me
CLIENT_FITNESS_PASSWORD_HASH=change-me
CLIENT_OUTDOORS_USERNAME=change-me
CLIENT_OUTDOORS_PASSWORD_HASH=change-me

# Legacy single-tenant guest login, predates the per-vertical CLIENT_* credentials
# above. Kept working during the migration, mapped to the fitness vertical. Optional:
# unset all three to disable it once every guest has migrated to CLIENT_FITNESS_USERNAME.
GUEST_USERNAME=change-me
GUEST_PASSWORD_HASH=change-me
GUEST_LABEL=change-me
